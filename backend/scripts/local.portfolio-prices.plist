<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.portfolio-prices</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/rmm/.nvm/versions/node/v24.14.0/bin/node</string>
        <string>/Users/rmm/portfolio-tracker/backend/src/jobs/fetchPrices.js</string>
    </array>
    <!-- Every 5 minutes. launchd also runs it once at load, and catches up
         after sleep/reboot instead of silently skipping. -->
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>/Users/rmm/portfolio-tracker/backend</string>
    <key>StandardOutPath</key>
    <string>/Users/rmm/portfolio-tracker/backend/data/fetch-prices.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rmm/portfolio-tracker/backend/data/fetch-prices.err.log</string>
</dict>
</plist>
