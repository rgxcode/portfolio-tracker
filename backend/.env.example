# Backend Environment Variables
# Copy this file to .env and fill in your values

# MongoDB connection string.
# Local development: a mongod running on the default port (see README → Local database).
COSMOS_DB_CONNECTION_STRING=mongodb://127.0.0.1:27017/portfolio-tracker

# JWT secret for auth tokens (use a long random string in production)
JWT_SECRET=change-me-to-a-random-secret

# Server port
PORT=4000
