# MongoDB connection string.
# Local: mongodb://127.0.0.1:27017/portfolio-tracker
# Deployed: your MongoDB Atlas mongodb+srv://... string
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio-tracker

# JWT signing secret — generate a fresh one per environment:
#   openssl rand -base64 32
JWT_SECRET=change-me-in-every-environment

# Server port
PORT=4000

# Market data provider keys (server-side only — never sent to the browser).
# Both are optional: the job falls back to keyless endpoints without them.
COINGECKO_API_KEY=
ALPHA_VANTAGE_API_KEY=
